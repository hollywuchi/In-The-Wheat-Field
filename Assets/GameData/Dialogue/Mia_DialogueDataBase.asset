    - name: Hollywuchi
      faceImage: {fileID: 21300000, guid: 9250cb0d0524f439fb2e48d5ecc828e5, type: 3}
      onLeft: 0
      dialogueText: "\u4F60\u597D\uFF0C\u8BF7\u95EE\u662FMia\u5C0F\u59D0\u5417\uFF1F"

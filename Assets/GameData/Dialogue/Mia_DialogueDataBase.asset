    - name: Hollywuchi
      faceImage: {fileID: 21300000, guid: 2acedd98a2e4247569fc702d2b8fc91d, type: 3}
      onLeft: 0
      dialogueText: "\u989D\uFF0C\u6211\u60F3\u4F60\u5E94\u8BE5\u8BA4\u9519\u4E86"
      hasToPause: 1
      isDown: 0
    - name: Mia
      faceImage: {fileID: 21300000, guid: 0ebf15807ee9d4dcaa0a1aed0fadf257, type: 3}
      onLeft: 1
      dialogueText: "\u54C8\u54C8\uFF0C\u6211\u600E\u4E48\u4F1A\u8BA4\u9519\u5462"
      hasToPause: 1
      isDown: 0
    - name: Mia
      faceImage: {fileID: 21300000, guid: 0ebf15807ee9d4dcaa0a1aed0fadf257, type: 3}
      onLeft: 1
      dialogueText: "\u5982\u679C\u4F60\u60F3\u627E\u5546\u4EBA\uFF0C\u73B0\u5728\u8FD8\u6CA1\u6709\u5F00\u95E8\u54E6\uFF0C\u7B49\u52308\u70B9\u534A\uFF0C\u6211\u4F1A\u53BB\u5357\u8FB9\u6446\u644A"

      isDown: 0
    - name: Mia
      faceImage: {fileID: 21300000, guid: 67d354b9f685e4e1b90255eb84bc5abe, type: 3}
      onLeft: 1
      dialogueText: "\u60F3\u4E70\u597D\u4E1C\u897F\u8BB0\u5F97\u6765\u90A3\u8FB9\u627E\u6211\u54E6~"
      hasToPause: 1
      isDown: 0
    - name: Hollywuchi
